{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered researcher or reader profile with access entitlements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "tier": { "type": "string", "enum": ["free", "dispatch", "fellow", "patron"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "displayName", "email", "tier", "createdAt"]
    },
    "UserInquiry": {
      "title": "UserInquiry",
      "description": "A consulting inquiry or custom laboratory audit request submitted by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serviceId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["pending", "analyzing", "completed", "archived"] },
        "privacy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "response": { "type": "string", "maxLength": 8000 }
      },
      "required": ["id", "userId", "serviceId", "title", "content", "status", "createdAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "User saved research artifacts, field notes, or experiments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["field_note", "experiment", "case"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "targetType", "targetId", "createdAt"]
    },
    "ArticleConsultation": {
      "title": "ArticleConsultation",
      "description": "Public or user-submitted research inquiries associated with a specific Field Note monograph",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "articleId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userDisplayName": { "type": "string", "maxLength": 120 },
        "question": { "type": "string", "maxLength": 1500 },
        "response": { "type": "string", "maxLength": 6000 },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "articleId", "userId", "userDisplayName", "question", "createdAt"]
    },
    "QuickAudit": {
      "title": "QuickAudit",
      "description": "User-generated interactive conversation autopsy and tension audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "inputSnippet": { "type": "string", "maxLength": 3000 },
        "contextType": { "type": "string", "maxLength": 100 },
        "fuelScore": { "type": "number" },
        "foolScore": { "type": "number" },
        "tensionRating": { "type": "string", "maxLength": 100 },
        "ruling": { "type": "string", "maxLength": 100 },
        "analysis": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "inputSnippet", "fuelScore", "foolScore", "ruling", "createdAt"]
    },
    "FieldNote": {
      "title": "FieldNote",
      "description": "Editorial research monograph written retrospectively in Mina's voice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "publicExcerpt": { "type": "string", "maxLength": 2000 },
        "excerpt": { "type": "string", "maxLength": 2000 },
        "publicPreviewParagraphs": { "type": "array", "items": { "type": "string" } },
        "premiumContentParagraphs": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "array", "items": { "type": "string" } },
        "accessLevel": { "type": "string", "enum": ["public", "premium", "internal"] },
        "isWeeklyFieldNote": { "type": "boolean" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "publicationDate": { "type": "string", "maxLength": 64 },
        "freeUntil": { "type": "string", "maxLength": 64 },
        "readingTimeMinutes": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "epistemicStatus": { "type": "string", "maxLength": 64 },
        "relatedExperimentIds": { "type": "array", "items": { "type": "string" } },
        "marginalia": { "type": "array", "items": { "type": "object" } },
        "fuelFoolBalance": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "version": { "type": "number" },
        "authorAgentId": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "slug", "chapterNumber", "title", "accessLevel", "publishedAt"]
    },
    "Experiment": {
      "title": "Experiment",
      "description": "Controlled empirical laboratory protocol and metric evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "accessLevel": { "type": "string", "enum": ["public", "premium", "internal"] },
        "status": { "type": "string", "enum": ["ACTIVE", "CONCLUDED", "PEER_REVIEW", "REPLICATING"] },
        "phase": { "type": "string", "maxLength": 128 },
        "hypothesis": { "type": "string", "maxLength": 2000 },
        "researchQuestion": { "type": "string", "maxLength": 2000 },
        "methodology": { "type": "string", "maxLength": 4000 },
        "sampleSize": { "type": "string", "maxLength": 256 },
        "observations": { "type": "array", "items": { "type": "string" } },
        "logs": { "type": "array", "items": { "type": "object" } },
        "metrics": { "type": "object" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "conclusion": { "type": "string", "maxLength": 4000 },
        "minaInterpretation": { "type": "string", "maxLength": 4000 },
        "foolDetectorAdversarialReview": { "type": "string", "maxLength": 4000 },
        "ethicalReviewStatus": { "type": "string", "enum": ["APPROVED", "PROVISIONAL", "RESTRICTED"] },
        "citations": { "type": "array", "items": { "type": "string" } },
        "relatedFieldNoteId": { "type": "string", "maxLength": 128 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "authorAgentId": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "code", "title", "accessLevel", "status", "hypothesis"]
    },
    "Case": {
      "title": "Case",
      "description": "Forensic anonymized conversation autopsy dossier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "accessLevel": { "type": "string", "enum": ["public", "premium", "internal"] },
        "contextType": { "type": "string", "maxLength": 128 },
        "anonymizedSubject": { "type": "string", "maxLength": 256 },
        "summary": { "type": "string", "maxLength": 3000 },
        "snippet": { "type": "string", "maxLength": 2000 },
        "timeline": { "type": "array", "items": { "type": "object" } },
        "attractionSignals": { "type": "array", "items": { "type": "string" } },
        "tensionDynamics": { "type": "string", "maxLength": 4000 },
        "reciprocityEvaluation": { "type": "string", "maxLength": 4000 },
        "ambiguityAnalysis": { "type": "string", "maxLength": 4000 },
        "projectionRisks": { "type": "array", "items": { "type": "string" } },
        "foolOrFuelVerdict": { "type": "object" },
        "recommendedProtocols": { "type": "array", "items": { "type": "string" } },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "authorAgentId": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "code", "title", "accessLevel", "contextType", "summary"]
    },
    "Hypothesis": {
      "title": "Hypothesis",
      "description": "Formal research hypothesis tracked across experiments and autopsies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "statement": { "type": "string", "maxLength": 2000 },
        "domain": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PROPOSED", "TESTING", "SUPPORTED", "REFUTED", "SUSPENDED"] },
        "confidenceScore": { "type": "number" },
        "supportingExperimentIds": { "type": "array", "items": { "type": "string" } },
        "authorAgentId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" }
      },
      "required": ["id", "code", "statement", "domain", "status", "authorAgentId"]
    },
    "AgentRun": {
      "title": "AgentRun",
      "description": "Structured execution artifact produced by a laboratory research agent (e.g. A04 Fool Detector)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 64 },
        "agentVersion": { "type": "string", "maxLength": 32 },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "provenance": { "type": "object" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "PARTIAL"] },
        "persistenceStatus": { "type": "string", "enum": ["FIRESTORE", "MEMORY_FALLBACK"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "agentId", "agentVersion", "input", "output", "provenance", "status", "createdAt"]
    }
  },
  "firestore": {
    "/fieldNotes/{noteId}": {
      "schema": { "$ref": "#/entities/FieldNote" },
      "description": "Public research monographs and field notes."
    },
    "/experiments/{experimentId}": {
      "schema": { "$ref": "#/entities/Experiment" },
      "description": "Controlled empirical research protocols and evaluations."
    },
    "/cases/{caseId}": {
      "schema": { "$ref": "#/entities/Case" },
      "description": "Forensic interaction autopsies and case studies."
    },
    "/hypotheses/{hypothesisId}": {
      "schema": { "$ref": "#/entities/Hypothesis" },
      "description": "Active and verified laboratory hypotheses."
    },
    "/agentRuns/{runId}": {
      "schema": { "$ref": "#/entities/AgentRun" },
      "description": "Executed agent diagnostic runs and epistemic audits."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records containing account settings and subscription tier."
    },
    "/users/{userId}/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/UserInquiry" },
      "description": "Private consulting submissions and research door inquiries submitted by the user."
    },
    "/users/{userId}/savedBookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Saved laboratory field notes, experiments, or autopsies bookmarked by the user."
    },
    "/articleConsultations/{consultationId}": {
      "schema": { "$ref": "#/entities/ArticleConsultation" },
      "description": "Article-specific questions and research commentary submitted for Field Notes."
    },
    "/quickAudits/{auditId}": {
      "schema": { "$ref": "#/entities/QuickAudit" },
      "description": "Real-time conversation autopsies run through the lab's quick audit instrument."
    }
  }
}
